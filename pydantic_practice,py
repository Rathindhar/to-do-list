from pydantic import BaseModel, EmailStr, AnyUrl, Field
from typing import List,Dict, Optional ,Annotated
#for 2 level validation we use List ,in normal list we can store an type of data
#If we use optional then we have to provide default value i.e. None
# we can also set default value 
#Built in custom datatype
#Emailstr for email
#anyurl for url
#Field function for data validation
#other purpose of field function is to attach metadata, with the help of annotated
#adding description to fields - Annotated
""" If we send '6.2' instead of 6.2 pydantic does a type coercion. TO 
avoid that we can use strict to restrict it"""

class Patient(BaseModel):
    name : Annotated[str,Field(max_length=50,title='Name of the patient',description='Give the name of the name of the patient in less than 50 chars',examples=['amit','Nitish'])]
    email: EmailStr
    linkedin_url:AnyUrl
    age:int = Field(gt=0, lt=120)
    weight: Annotated[float,Field(gt=0,strict=True)]
    married: Annotated[bool,Field(default=None, description='Is the patient married or not')] #default value, it's also optional
    allergies: Annotated[Optional[List[str]],Field(default=None,max_length=5)]
    contact_details: Dict[str,str]


def insert_patient_data(patient:Patient):
    print(patient.name)
    print(patient.age)
    print('inserted')

patient_info = {'name':'abc','age':30, 'weight':79.4, 'married':True, 'allergies':['pollen','dust'],'contact_details':{'email':'arf@gmail.com','phone':'3867643445'}}
patient1 = Patient(**patient_info)

insert_patient_data(patient1)